{
  "name": "huntly",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Huntly — AI-powered Job Intelligence OS",
  "scripts": {
    "dev": "pnpm --filter @huntly/desktop dev",
    "dev:server": "pnpm --filter @huntly/server dev",
    "dev:all": "pnpm --parallel --filter @huntly/server --filter @huntly/desktop dev",
    "seed": "pnpm --filter @huntly/server exec tsx src/seed.ts",
    "build:all": "pnpm run --recursive build",
    "typecheck": "pnpm run --recursive --if-present typecheck",
    "test": "pnpm run --recursive --if-present test",
    "lint": "pnpm run --recursive --if-present lint",
    "db:generate": "pnpm --filter @huntly/database generate",
    "db:migrate": "pnpm --filter @huntly/database migrate",
    "db:studio": "pnpm --filter @huntly/database studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
