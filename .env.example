# Environment Variables for Huntly
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════
# Gemini AI
# ═══════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ═══════════════════════════════════════
# Search Provider (auto, brave, serper, serpapi, tavily)
# ═══════════════════════════════════════
# Leave as "auto" to automatically use any configured key with fallback
SEARCH_PROVIDER=auto

# Option A: Brave Search API (https://api.search.brave.com)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Option B: Serper (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Option C: SerpAPI (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Option D: Tavily Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# ═══════════════════════════════════════
# Database
# ═══════════════════════════════════════
DATABASE_PATH=./huntly.db

# ═══════════════════════════════════════
# Server
# ═══════════════════════════════════════
SERVER_PORT=7842
SERVER_HOST=127.0.0.1

# ═══════════════════════════════════════
# Crawler
# ═══════════════════════════════════════
CRAWLER_CONCURRENCY=3
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=true
