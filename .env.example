# Environment Variables for AgentForge
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════
# Gemini AI
# ═══════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ═══════════════════════════════════════
# Search Provider (choose one)
# ═══════════════════════════════════════
# Option A: Serper (https://serper.dev)
SEARCH_PROVIDER=serper
SERPER_API_KEY=your_serper_api_key_here

# Option B: SerpAPI (https://serpapi.com)
# SEARCH_PROVIDER=serpapi
# SERPAPI_KEY=your_serpapi_key_here

# Option C: Brave Search API (https://api.search.brave.com)
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# ═══════════════════════════════════════
# Database
# ═══════════════════════════════════════
DATABASE_PATH=./agentforge.db

# ═══════════════════════════════════════
# Server
# ═══════════════════════════════════════
SERVER_PORT=7842
SERVER_HOST=127.0.0.1

# ═══════════════════════════════════════
# Crawler
# ═══════════════════════════════════════
CRAWLER_CONCURRENCY=3
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=true
